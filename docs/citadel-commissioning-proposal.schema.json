      "required": [
        "deployment_custodian",
        "authority_custodian",
        "signer_interface",
        "fingerprint_confirmation",
        "storage_protection",
        "administrative_access",
        "writer_quiescence",
        "backup_restore",
        "legacy_fence_acceptance",
        "initial_adoption_attestation"

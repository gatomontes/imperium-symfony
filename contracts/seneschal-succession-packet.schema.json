{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imperium.invalid/contracts/seneschal-succession-packet.schema.json",
  "title": "Seneschal Succession Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "packet_id", "packet_version", "mission_instance_id",
    "directive_ref", "suitability_demand_ref", "prepared_by", "mission_dossier_ref",
    "current_mandate_ref", "authorizations", "pending_decisions", "commitments",
    "commissions", "unresolved_disagreements", "dependencies", "evidence_index_ref",
    "incumbent_contributions", "expected_current_generation", "expected_next_generation",
    "sealed_at", "digest_spec", "content_digest"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "packet_id": { "$ref": "#/$defs/nonempty" },
    "packet_version": { "$ref": "#/$defs/nonempty" },
    "mission_instance_id": { "$ref": "#/$defs/nonempty" },
    "directive_ref": { "$ref": "#/$defs/versionedRef" },
    "suitability_demand_ref": { "$ref": "#/$defs/versionedRef" },
    "prepared_by": {
      "type": "object", "additionalProperties": false,
      "required": ["seat_id", "manifestation_id", "occupancy_generation"],
      "properties": {
        "seat_id": { "const": "curia.chamberlain" },
        "manifestation_id": { "$ref": "#/$defs/nonempty" },
        "occupancy_generation": { "type": "integer", "minimum": 1 }
      }
    },
    "mission_dossier_ref": { "$ref": "#/$defs/versionedRef" },
    "current_mandate_ref": { "$ref": "#/$defs/versionedRef" },
    "authorizations": { "$ref": "#/$defs/refSet" },
    "pending_decisions": { "$ref": "#/$defs/refSet" },
    "commitments": { "$ref": "#/$defs/refSet" },
    "commissions": { "$ref": "#/$defs/refSet" },
    "unresolved_disagreements": { "$ref": "#/$defs/refSet" },
    "dependencies": { "$ref": "#/$defs/refSet" },
    "evidence_index_ref": { "$ref": "#/$defs/digestRef" },
    "incumbent_contributions": { "$ref": "#/$defs/refSet" },
    "expected_current_generation": { "type": "integer", "minimum": 1 },
    "expected_next_generation": { "type": "integer", "minimum": 2 },
    "sealed_at": { "type": "string", "format": "date-time" },
    "digest_spec": { "$ref": "#/$defs/digestSpec" },
    "content_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "digestRef": {
      "type": "object", "additionalProperties": false, "required": ["id", "digest"],
      "properties": { "id": { "$ref": "#/$defs/nonempty" }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "versionedRef": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" }, "version": { "$ref": "#/$defs/nonempty" }, "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "refSet": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/digestRef" } },
    "digestSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "omitted_fields"],
      "properties": {
        "algorithm": { "const": "sha256" }, "canonicalization": { "const": "rfc8785" },
        "omitted_fields": { "const": ["content_digest"] }
      }
    }
  }
}

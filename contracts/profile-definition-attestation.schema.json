{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imperium.invalid/contracts/profile-definition-attestation.schema.json",
  "title": "Imperium Profile Definition Lifecycle Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "attestation_id", "definition_ref", "transition", "actor", "issued_at", "correlation_id", "reason", "record_digest"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "attestation_id": { "$ref": "#/$defs/nonempty" },
    "definition_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["definition_id", "definition_version", "content_digest"],
      "properties": {
        "definition_id": { "$ref": "#/$defs/nonempty" },
        "definition_version": { "$ref": "#/$defs/nonempty" },
        "content_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["to"],
      "properties": {
        "from": { "enum": ["candidate", "approved", "current"] },
        "to": { "enum": ["approved", "current", "superseded", "revoked"] },
        "prior_attestation_id": { "$ref": "#/$defs/nonempty" }
      }
    },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": { "kind": { "enum": ["imperator", "office_mechanic"] }, "id": { "$ref": "#/$defs/nonempty" } }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "$ref": "#/$defs/nonempty" },
    "reason": { "$ref": "#/$defs/nonempty" },
    "record_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}

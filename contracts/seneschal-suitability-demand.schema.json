{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imperium.invalid/contracts/seneschal-suitability-demand.schema.json",
  "title": "Seneschal Suitability Demand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "demand_id", "demand_version", "mission_instance_id",
    "mission_mandate_ref", "authoring_disposition_ref", "axes",
    "hard_constraints", "preferred_traits", "disqualifiers",
    "evaluate_standard_first", "lineage", "digest_spec", "content_digest"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "demand_id": { "$ref": "#/$defs/nonempty" },
    "demand_version": { "$ref": "#/$defs/nonempty" },
    "mission_instance_id": { "$ref": "#/$defs/nonempty" },
    "mission_mandate_ref": { "$ref": "#/$defs/versionedRef" },
    "authoring_disposition_ref": { "$ref": "#/$defs/digestRef" },
    "planning_authorization_ref": { "$ref": "#/$defs/digestRef" },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_expenditure", "technical_evidence", "response_urgency",
        "irreversible_action", "residual_risk", "expert_dissent", "delegation_style"
      ],
      "properties": {
        "resource_expenditure": { "$ref": "#/$defs/axis" },
        "technical_evidence": { "$ref": "#/$defs/axis" },
        "response_urgency": { "$ref": "#/$defs/axis" },
        "irreversible_action": { "$ref": "#/$defs/axis" },
        "residual_risk": { "$ref": "#/$defs/axis" },
        "expert_dissent": { "$ref": "#/$defs/axis" },
        "delegation_style": { "$ref": "#/$defs/axis" }
      }
    },
    "hard_constraints": { "$ref": "#/$defs/stringSet" },
    "preferred_traits": { "$ref": "#/$defs/stringSet" },
    "disqualifiers": { "$ref": "#/$defs/stringSet" },
    "evaluate_standard_first": { "type": "boolean" },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_from"],
      "properties": {
        "created_from": { "$ref": "#/$defs/digestRef" },
        "supersedes": { "$ref": "#/$defs/versionedRef" }
      }
    },
    "digest_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "omitted_fields"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "const": "rfc8785" },
        "omitted_fields": { "const": ["content_digest"] }
      }
    },
    "content_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "digestRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": { "id": { "$ref": "#/$defs/nonempty" }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "versionedRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "version": { "$ref": "#/$defs/nonempty" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "stringSet": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
    "axis": {
      "type": "object", "additionalProperties": false,
      "required": ["posture", "rationale", "evidence_refs"],
      "properties": {
        "posture": {
          "enum": [
            "not_material", "restrictive", "balanced", "permissive",
            "risk_asymmetric", "exploratory", "strict", "forensic",
            "deliberate", "rapid", "crisis", "cautious", "prohibitive",
            "tolerant", "low_tolerance", "near_zero", "consultative",
            "active_solicitation", "mandatory_challenge", "centralized", "delegative"
          ]
        },
        "rationale": { "$ref": "#/$defs/nonempty" },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/digestRef" } }
      }
    }
  }
}

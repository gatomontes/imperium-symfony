  "$defs": {
    "ownerDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload",
        "signature"
      ],
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "citadel_id",
            "trust_fingerprint",
            "effect",
            "object_digest",
            "issued_at",
            "expires_at",
            "nonce"
          ],
          "properties": {
            "schema": {
              "const": "imperium.citadel-owner-decision/v1"
            },
            "citadel_id": {
              "type": "string"
            },
            "trust_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "effect": {
              "type": "string"
            },
            "object_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "issued_at": {
              "type": "integer"
            },
            "expires_at": {
              "type": "integer"
            },
            "nonce": {
              "type": "string",
              "pattern": "^[a-f0-9]{48}$"
            }
          }
        },
        "signature": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }

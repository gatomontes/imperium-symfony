{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imperium.invalid/contracts/profile-artifact.schema.json",
  "title": "Imperium Profile Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "profile_id", "profile_version", "artifact_class",
    "source_persona", "steward", "target", "transformation",
    "cognitive_payload", "qualification_contract", "lineage",
    "digest_spec", "content_digest"
  ],
  "properties": {
    "contract_version": { "type": "string", "const": "1.0.0" },
    "profile_id": { "$ref": "#/$defs/nonempty" },
    "profile_version": { "$ref": "#/$defs/nonempty" },
    "artifact_class": {
      "enum": ["examination_only", "officer", "operative"]
    },
    "source_persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona_id", "persona_version", "persona_digest", "admission_state", "evidence_record"],
      "properties": {
        "persona_id": { "$ref": "#/$defs/nonempty" },
        "persona_version": { "$ref": "#/$defs/nonempty" },
        "persona_digest": { "$ref": "#/$defs/digest" },
        "admission_state": { "enum": ["pending_admission", "admitted"] },
        "evidence_record": { "$ref": "#/$defs/nonempty" }
      }
    },
    "steward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["office", "external_steward"] },
        "id": { "$ref": "#/$defs/nonempty" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["seat", "mission_role", "senate_examination"] },
        "id": { "$ref": "#/$defs/nonempty" }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "specification_version", "alchemist_disposition_id"],
      "properties": {
        "case_id": { "$ref": "#/$defs/nonempty" },
        "specification_version": { "$ref": "#/$defs/nonempty" },
        "alchemist_disposition_id": { "$ref": "#/$defs/nonempty" }
      }
    },
    "cognitive_payload": { "type": "object" },
    "model_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_model_version", "authorization_id", "source_line", "configuration", "constraints", "fallbacks", "access_assertion_required"],
      "properties": {
        "provider_model_version": { "$ref": "#/$defs/nonempty" },
        "authorization_id": { "$ref": "#/$defs/nonempty" },
        "source_line": {
          "type": "object", "additionalProperties": false,
          "required": ["line_number", "line_digest"],
          "properties": {
            "line_number": { "type": "integer", "minimum": 1 },
            "line_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "configuration": { "type": "object" },
        "constraints": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
        "fallbacks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
        "access_assertion_required": { "type": "boolean", "const": true }
      }
    },
    "qualification_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "criteria"],
      "properties": {
        "contract_id": { "$ref": "#/$defs/nonempty" },
        "criteria": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/nonempty" }
        }
      }
    },
    "limitations": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_from"],
      "properties": {
        "derived_from": { "$ref": "#/$defs/nonempty" },
        "supersedes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile_id", "profile_version", "content_digest"],
          "properties": {
            "profile_id": { "$ref": "#/$defs/nonempty" },
            "profile_version": { "$ref": "#/$defs/nonempty" },
            "content_digest": { "$ref": "#/$defs/digest" }
          }
        }
      }
    },
    "digest_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "omitted_fields"],
      "properties": {
        "algorithm": { "enum": ["sha256"] },
        "canonicalization": { "enum": ["rfc8785"] },
        "omitted_fields": {
          "type": "array", "const": ["content_digest"]
        }
      }
    },
    "content_digest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    {
      "if": { "properties": { "artifact_class": { "const": "examination_only" } } },
      "then": {
        "properties": {
          "source_persona": {
            "properties": { "admission_state": { "const": "pending_admission" } }
          },
          "target": { "properties": { "kind": { "const": "senate_examination" } } }
        }
      }
    },
    {
      "if": { "properties": { "artifact_class": { "enum": ["officer", "operative"] } } },
      "then": {
        "properties": {
          "source_persona": {
            "properties": { "admission_state": { "const": "admitted" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "artifact_class": { "const": "officer" } } },
      "then": {
        "properties": {
          "steward": { "properties": { "kind": { "const": "office" } } },
          "target": { "properties": { "kind": { "const": "seat" } } }
        }
      }
    }
  ],
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}

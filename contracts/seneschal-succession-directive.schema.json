{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imperium.invalid/contracts/seneschal-succession-directive.schema.json",
  "title": "Seneschal Succession Directive",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "directive_id", "directive_version", "mission_instance_id",
    "disposition", "basis", "incumbent", "current_mandate_ref", "interim_status",
    "resource_limits", "authority", "issued_at", "expires_at", "replay_key",
    "digest_spec", "content_digest", "signature"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "directive_id": { "$ref": "#/$defs/nonempty" },
    "directive_version": { "$ref": "#/$defs/nonempty" },
    "mission_instance_id": { "$ref": "#/$defs/nonempty" },
    "disposition": { "enum": ["clarify_mandate", "evaluate_mismatch", "replace", "suspend_and_replace"] },
    "basis": { "$ref": "#/$defs/nonempty" },
    "incumbent": {
      "type": "object", "additionalProperties": false,
      "required": ["seat_id", "manifestation_id", "occupancy_generation"],
      "properties": {
        "seat_id": { "const": "curia.seneschal" },
        "manifestation_id": { "$ref": "#/$defs/nonempty" },
        "occupancy_generation": { "type": "integer", "minimum": 1 }
      }
    },
    "current_mandate_ref": { "$ref": "#/$defs/versionedRef" },
    "suitability_demand_ref": { "$ref": "#/$defs/versionedRef" },
    "interim_status": { "enum": ["retain_until_transfer", "suspend_at_boundary", "suspend_immediately"] },
    "resource_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "maximum_cost", "maximum_duration_seconds"],
      "properties": {
        "currency": { "$ref": "#/$defs/nonempty" },
        "maximum_cost": { "type": "number", "minimum": 0 },
        "maximum_duration_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["imperator_id", "authority_ref"],
      "properties": {
        "imperator_id": { "$ref": "#/$defs/nonempty" },
        "authority_ref": { "$ref": "#/$defs/digestRef" }
      }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "replay_key": { "$ref": "#/$defs/nonempty" },
    "digest_spec": { "$ref": "#/$defs/digestSpec" },
    "content_digest": { "$ref": "#/$defs/digest" },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["signer", "algorithm", "key_id", "value"],
      "properties": {
        "signer": { "$ref": "#/$defs/nonempty" },
        "algorithm": { "$ref": "#/$defs/nonempty" },
        "key_id": { "$ref": "#/$defs/nonempty" },
        "value": { "$ref": "#/$defs/nonempty" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "disposition": { "enum": ["replace", "suspend_and_replace"] } } },
      "then": { "required": ["suitability_demand_ref"] }
    },
    {
      "if": { "properties": { "disposition": { "const": "suspend_and_replace" } } },
      "then": { "properties": { "interim_status": { "const": "suspend_immediately" } } }
    }
  ],
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "digestRef": {
      "type": "object", "additionalProperties": false, "required": ["id", "digest"],
      "properties": { "id": { "$ref": "#/$defs/nonempty" }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "versionedRef": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" }, "version": { "$ref": "#/$defs/nonempty" }, "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "digestSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "omitted_fields"],
      "properties": {
        "algorithm": { "const": "sha256" }, "canonicalization": { "const": "rfc8785" },
        "omitted_fields": { "const": ["content_digest", "signature"] }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imperium.invalid/contracts/profile-attestation.schema.json",
  "title": "Imperium Profile Lifecycle Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "attestation_id", "profile_ref", "transition",
    "actor", "issued_at", "correlation_id", "reason", "record_digest"
  ],
  "properties": {
    "contract_version": { "type": "string", "const": "1.0.0" },
    "attestation_id": { "$ref": "#/$defs/nonempty" },
    "profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "content_digest"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/nonempty" },
        "profile_version": { "$ref": "#/$defs/nonempty" },
        "content_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to"],
      "properties": {
        "from": {
          "enum": [
            "candidate", "under_examination", "approved", "current_active",
            "created", "packaged", "instantiated", "consumed"
          ]
        },
        "to": {
          "enum": [
            "candidate", "under_examination", "approved", "current_active",
            "superseded", "revoked", "expired", "created", "packaged",
            "instantiated", "consumed"
          ]
        },
        "prior_attestation_id": { "$ref": "#/$defs/nonempty" }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["seat", "imperator", "office_mechanic", "external_authority"] },
        "id": { "$ref": "#/$defs/nonempty" }
      }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "$ref": "#/$defs/nonempty" },
    "reason": { "$ref": "#/$defs/nonempty" },
    "examination_disposition_id": { "$ref": "#/$defs/nonempty" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer", "algorithm", "value"],
      "properties": {
        "signer": { "$ref": "#/$defs/nonempty" },
        "algorithm": { "$ref": "#/$defs/nonempty" },
        "key_id": { "$ref": "#/$defs/nonempty" },
        "value": { "$ref": "#/$defs/nonempty" }
      }
    },
    "record_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
